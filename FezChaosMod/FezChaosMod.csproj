<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FEZ.ChaosMod.mm</RootNamespace>
    <AssemblyName>FEZ.ChaosMod.mm</AssemblyName>

    <!-- Retaining original FEZ constant and common settings -->
    <DefineConstants>FEZCLIENT</DefineConstants>
    <Platforms>x86</Platforms>

    <!-- Your Assembly Information -->
    <Product>FezMultiplayerMod</Product>
    <Description>A multiplayer mod for FEZ.</Description>
    <Copyright>Copyright © Jenna Sloan</Copyright>
    <Company>FEZ Modding</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Don't include dependencies -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Disables the generation of the .deps.json file completely -->
    <GenerateDependencyFile>false</GenerateDependencyFile>

  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../UserProperties.xml"
    Condition="Exists('$(MSBuildThisFileDirectory)../UserProperties.xml')" />

  <Target Name="VerifyModReferences" BeforeTargets="Build">
    <Error Text="You forgot to configure UserProperties.xml"
      Condition="!Exists('$(MSBuildThisFileDirectory)../UserProperties.xml')" />
  </Target>

  <Target Name="PrepareMod" AfterTargets="Build">
    <PropertyGroup>
      <ModCompileOutputDir Condition="'$(ModOutputDir)' != ''">$(ModOutputDir)</ModCompileOutputDir>
      <ModCompileOutputDir Condition="'$(ModOutputDir)' == ''">$(ProjectDir)out</ModCompileOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <ModFiles
        Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb;$(ProjectDir)..\Metadata.xml" />
    </ItemGroup>

    <MakeDir Directories="$(ModCompileOutputDir)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModCompileOutputDir)" />
    <Copy SourceFiles="@(NativeAssets)"
      DestinationFolder="$(ModCompileOutputDir)\runtimes\%(RecursiveDir)" />
  </Target>


  <!-- External Assembly References from your libs folder -->
  <ItemGroup>
    <Reference Include="Common">
      <HintPath>$(FezDir)\Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ContentSerialization">
      <HintPath>$(FezDir)\ContentSerialization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="EasyStorage">
      <HintPath>$(FezDir)\EasyStorage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FEZ">
      <HintPath>$(FezDir)\HAT.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FezEngine">
      <HintPath>$(FezDir)\FezEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(FezDir)\FNA.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="XnaWordWrapCore">
      <HintPath>$(FezDir)\XnaWordWrapCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(MonoModDir)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(MonoModDir)\MonoMod.Utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(MonoModDir)\Mono.Cecil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IMGUI">
      <HintPath>$(ImGuiDir)\IMGUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(ImGuiDir)\ImGui.NET.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
